{
  "name": "moovibe",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "cloud:check": "node scripts/cloud-check.mjs",
    "cloud:provision": "node scripts/cloud-provision.mjs",
    "db:migrate": "wrangler d1 migrations apply MOOVIBE_LIBRARY --remote --config workers/pipeline/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply MOOVIBE_LIBRARY --local --config workers/pipeline/wrangler.jsonc",
    "sqlite:migrate": "node scripts/migrate-sqlite-to-d1.mjs",
    "worker:dev": "wrangler dev --config workers/pipeline/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config workers/pipeline/wrangler.jsonc",
    "worker:tail": "wrangler tail moovibe-pipeline --format pretty",
    "pages:dev": "wrangler pages dev . --d1 MOOVIBE_LIBRARY --kv MOOVIBE_DB --binding RECOMMENDER_VERSION=v2",
    "pages:config:download": "wrangler pages download config moovibe",
    "pages:deploy": "wrangler pages deploy . --project-name moovibe"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "better-sqlite3": "^12.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "latest"
  }
}
